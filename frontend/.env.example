VITE_API_URL=http://localhost:3333/api

# Senha sugerida ao criar um novo usuário (apenas pré-preenche o campo do formulário).
# Deixe vazio para o campo começar em branco. Nunca comite a senha real aqui:
# variáveis VITE_* são embutidas no bundle e ficam visíveis no navegador.
VITE_SENHA_PADRAO=

# Domínio usado para montar o e-mail ao criar usuários (ex.: @instituicao.gov.br).
# Defina o domínio real apenas no .env do ambiente.
VITE_EMAIL_DOMINIO=@exemplo.local
