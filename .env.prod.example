# Modelo para o .env.prod do docker-compose.prod.yml.
# Copie para `.env.prod`, preencha e NUNCA comite o arquivo preenchido.

# ── Banco ─────────────────────────────────────────────────────────────────────
POSTGRES_DB=criapesquisa
POSTGRES_USER=cria_user
# Senha longa e aleatória. Sugestão para gerar:  openssl rand -base64 32
POSTGRES_PASSWORD=

# O host é 'postgres' (nome do serviço no compose), não localhost.
# Se a senha tiver @ / : ou #, ela precisa vir percent-encoded aqui.
DATABASE_URL=postgresql://cria_user:SENHA_AQUI@postgres:5432/criapesquisa?schema=public

# ── API ───────────────────────────────────────────────────────────────────────
# Segredo de assinatura dos tokens. A API se recusa a subir sem ele em produção.
# Trocar este valor invalida todas as sessões ativas.  openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES=8h

# Origens que podem chamar a API. Servindo tudo pelo mesmo nginx, é o endereço
# público do sistema. Separe múltiplas por vírgula, sem barra no final.
CORS_ORIGIN=https://criapesquisa.al.gov.br

# ── Front ─────────────────────────────────────────────────────────────────────
# Domínio institucional usado para montar e-mails na criação de usuários.
VITE_EMAIL_DOMINIO=@secria.al.gov.br

# Porta em que o nginx do front escuta no host. Deixe atrás do proxy que
# termina o TLS — não sirva o sistema em HTTP na internet.
WEB_PORT=8080

# ── Seed (só na primeira subida) ──────────────────────────────────────────────
# Senha inicial das quatro contas-base. Todas nascem exigindo troca no primeiro
# acesso, mas escolha algo forte: esta senha circula por quem for cadastrar.
SEED_PASSWORD=
SEED_EMAIL_DOMINIO=@secria.al.gov.br
