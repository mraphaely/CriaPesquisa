generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PapelUsuario {
  ADMIN
  GESTOR
  COLETADOR
  VISUALIZADOR
}

enum StatusPesquisa {
  RASCUNHO
  PUBLICADA
  ENCERRADA
  ARQUIVADA
}

enum TipoPergunta {
  TEXTO
  NUMERO
  DATA
  MULTIPLA_ESCOLHA
  ESCOLHA_UNICA
  CAMPO_ABERTO
}

enum AcaoLog {
  CREATE
  UPDATE
  DELETE
  RESTORE
  PUBLICAR
  ENCERRAR
  ARQUIVAR
}

model Usuario {
  id        String       @id @default(uuid())
  nome      String
  email     String       @unique
  senhaHash String
  papel     PapelUsuario
  ativo     Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  pesquisasResponsavel Pesquisa[]        @relation("PesquisaResponsavel")
  pesquisasCriadas     Pesquisa[]        @relation("PesquisaCriadaPor")
  respostasColetadas   Resposta[]        @relation("RespostaColetadaPor")
  logs                 LogAlteracao[]
  versoes              PesquisaVersao[]
}

model MunicipioMensal {
  id                 Int    @id @default(autoincrement())
  ano                Int
  mes                Int
  mesNome            String
  municipio          String
  regional           String
  totalBeneficiarios Int
  criancas           Int
  gestantes          Int
  valorTotal         Float
  rendaMedia         Float

  @@unique([ano, mes, municipio])
  @@index([ano, mes])
  @@index([regional])
  @@index([municipio])
}

model BeneficioComposicao {
  id         Int    @id @default(autoincrement())
  ano        Int
  mes        Int
  label      String
  quantidade Int

  @@index([ano, mes])
}

model Pesquisa {
  id            String         @id @default(uuid())
  titulo        String
  descricao     String?
  responsavelId String
  status        StatusPesquisa @default(RASCUNHO)
  periodoInicio DateTime?      @db.Date
  periodoFim    DateTime?      @db.Date
  publicadaEm   DateTime?
  encerradaEm   DateTime?
  versaoAtual   Int            @default(1)
  createdById   String
  updatedById   String?
  deletedAt     DateTime?
  deletedById   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  responsavel Usuario          @relation("PesquisaResponsavel", fields: [responsavelId], references: [id])
  createdBy   Usuario          @relation("PesquisaCriadaPor", fields: [createdById], references: [id])
  secoes      Secao[]
  perguntas   Pergunta[]
  respostas   Resposta[]
  versoes     PesquisaVersao[]

  @@index([status])
  @@index([responsavelId])
  @@index([deletedAt])
}

model Secao {
  id         String  @id @default(uuid())
  pesquisaId String
  titulo     String
  descricao  String?
  ordem      Int

  pesquisa  Pesquisa   @relation(fields: [pesquisaId], references: [id], onDelete: Cascade)
  perguntas Pergunta[]

  @@index([pesquisaId, ordem])
}

model Pergunta {
  id          String       @id @default(uuid())
  pesquisaId  String
  secaoId     String?
  enunciado   String
  tipo        TipoPergunta
  obrigatoria Boolean      @default(false)
  ordem       Int
  ajuda       String?

  pesquisa Pesquisa        @relation(fields: [pesquisaId], references: [id], onDelete: Cascade)
  secao    Secao?          @relation(fields: [secaoId], references: [id])
  opcoes   OpcaoPergunta[]
  itens    ItemResposta[]

  @@index([pesquisaId, ordem])
}

model OpcaoPergunta {
  id         String @id @default(uuid())
  perguntaId String
  texto      String
  ordem      Int

  pergunta Pergunta @relation(fields: [perguntaId], references: [id], onDelete: Cascade)

  @@index([perguntaId, ordem])
}

model Resposta {
  id          String    @id @default(uuid())
  pesquisaId  String
  coletadorId String
  municipio   String?
  unidade     String?
  regional    String?
  enviadaEm   DateTime  @default(now())
  ip          String?
  deletedAt   DateTime?
  deletedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  pesquisa  Pesquisa       @relation(fields: [pesquisaId], references: [id])
  coletador Usuario        @relation("RespostaColetadaPor", fields: [coletadorId], references: [id])
  itens     ItemResposta[]

  @@index([pesquisaId])
  @@index([municipio])
  @@index([enviadaEm])
  @@index([deletedAt])
}

model ItemResposta {
  id                 String    @id @default(uuid())
  respostaId         String
  perguntaId         String
  valorTexto         String?
  valorNumero        Float?
  valorData          DateTime? @db.Date
  opcoesSelecionadas String[]

  resposta Resposta @relation(fields: [respostaId], references: [id], onDelete: Cascade)
  pergunta Pergunta @relation(fields: [perguntaId], references: [id])

  @@index([respostaId])
  @@index([perguntaId])
}

model LogAlteracao {
  id          String   @id @default(uuid())
  entidade    String
  entidadeId  String
  acao        AcaoLog
  usuarioId   String
  dadosAntes  Json?
  dadosDepois Json?
  ip          String?
  createdAt   DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([entidade, entidadeId])
  @@index([usuarioId])
  @@index([createdAt])
}

model PesquisaVersao {
  id           String   @id @default(uuid())
  pesquisaId   String
  versao       Int
  snapshot     Json
  usuarioId    String
  createdAt    DateTime @default(now())

  pesquisa Pesquisa @relation(fields: [pesquisaId], references: [id], onDelete: Cascade)
  usuario  Usuario  @relation(fields: [usuarioId], references: [id])

  @@unique([pesquisaId, versao])
}
